{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "permission": {
    "lsp": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "question": "allow",
    
    "*": "allow",
    "bash": {
      "*": "allow",
      "git stash": "deny",
      "git stash *": "deny",
      "git push": "deny",
      "git push *": "deny",
      "rm": "deny",
      "rm *": "deny"
    }
  }
}