{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["superpowers@git+https://github.com/obra/superpowers.git"],
  "lsp": true,
  "instructions": ["~/.config/opencode/memory-mechanism.md"],
  "permission": {
    "lsp": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "question": "allow",
    
    "*": "allow",
    "git stash": "deny",
    "git push": "deny",
    "rm": "deny",
  }
}